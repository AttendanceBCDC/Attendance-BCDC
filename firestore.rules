rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'byardeliaco@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(data) {
      return isVerified() && data.ownerId == request.auth.uid;
    }

    function isValidMonthKey(mk) {
      return mk is string && mk.size() == 7 && mk.matches('^[0-9]{4}-[0-9]{2}$');
    }

    function isValidTherapyCode(code) {
      return code in ['SI', 'TW', 'OT', 'BT', 'RM', 'FS', 'E', 'Izin', 'Ganti', 'Hutang', 'Hangus'];
    }

    function isValidSpecialty(spec) {
      return spec in ['SI', 'TW', 'OT', 'BT', 'RM', 'FS', 'E'];
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'clinicName', 'seeded', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'clinicName', 'seeded', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.clinicName is string && data.clinicName.size() >= 1 && data.clinicName.size() <= 100
        && data.seeded is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTherapist(data) {
      return data.keys().hasAll(['ownerId', 'name', 'specialty', 'roleTitle', 'monthlyTargetHours', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'specialty', 'roleTitle', 'monthlyTargetHours', 'active', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && isValidSpecialty(data.specialty)
        && data.roleTitle is string && data.roleTitle.size() >= 1 && data.roleTitle.size() <= 80
        && (data.monthlyTargetHours is int || data.monthlyTargetHours is float)
        && data.monthlyTargetHours >= 1 && data.monthlyTargetHours <= 400
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClient(data) {
      return data.keys().hasAll(['ownerId', 'name', 'program', 'defaultSppSessions', 'primaryTherapistId', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'program', 'defaultSppSessions', 'primaryTherapistId', 'active', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.program is string && data.program.size() >= 1 && data.program.size() <= 80
        && (data.defaultSppSessions is int || data.defaultSppSessions is float)
        && data.defaultSppSessions >= 0 && data.defaultSppSessions <= 100
        && isValidId(data.primaryTherapistId)
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSppPackage(data) {
      return data.keys().hasAll(['ownerId', 'clientId', 'monthKey', 'paidSessions', 'packageName', 'sppFee', 'paymentStatus', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'clientId', 'monthKey', 'paidSessions', 'packageName', 'sppFee', 'paymentStatus', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidId(data.clientId)
        && isValidMonthKey(data.monthKey)
        && (data.paidSessions is int || data.paidSessions is float)
        && data.paidSessions >= 0 && data.paidSessions <= 100
        && data.packageName is string && data.packageName.size() >= 1 && data.packageName.size() <= 80
        && (data.sppFee is int || data.sppFee is float)
        && data.sppFee >= 0 && data.sppFee <= 100000000
        && data.paymentStatus in ['Lunas', 'Cicilan', 'Belum Bayar']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAttendanceEntry(data) {
      return data.keys().hasAll(['ownerId', 'monthKey', 'dayOfMonth', 'slot', 'clientId', 'therapistId', 'code', 'hours', 'notes', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'monthKey', 'dayOfMonth', 'slot', 'clientId', 'therapistId', 'code', 'hours', 'notes', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidMonthKey(data.monthKey)
        && data.dayOfMonth is int && data.dayOfMonth >= 1 && data.dayOfMonth <= 31
        && data.slot is int && data.slot >= 1 && data.slot <= 2
        && isValidId(data.clientId)
        && isValidId(data.therapistId)
        && isValidTherapyCode(data.code)
        && (data.hours is int || data.hours is float)
        && data.hours >= 0 && data.hours <= 12
        && data.notes is string && data.notes.size() <= 240
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTherapistClaim(data) {
      return data.keys().hasAll(['ownerId', 'monthKey', 'dayOfMonth', 'therapistId', 'clientId', 'code', 'claimedHours', 'reconcileStatus', 'claimNote', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'monthKey', 'dayOfMonth', 'therapistId', 'clientId', 'code', 'claimedHours', 'reconcileStatus', 'claimNote', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidMonthKey(data.monthKey)
        && data.dayOfMonth is int && data.dayOfMonth >= 1 && data.dayOfMonth <= 31
        && isValidId(data.therapistId)
        && isValidId(data.clientId)
        && isValidTherapyCode(data.code)
        && (data.claimedHours is int || data.claimedHours is float)
        && data.claimedHours >= 0 && data.claimedHours <= 12
        && data.reconcileStatus in ['pending', 'matched', 'discrepancy', 'resolved']
        && data.claimNote is string && data.claimNote.size() <= 240
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /test/connection {
      allow get: if isSignedIn();
    }

    match /users/{userId} {
      allow get: if isVerified() && isValidId(userId) && (userId == request.auth.uid || isBootstrappedAdmin());
      allow list: if isVerified() && (resource.data.uid == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerified()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(userId)
        && (userId == request.auth.uid || isBootstrappedAdmin())
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'clinicName', 'seeded', 'updatedAt']);
      allow delete: if false;
    }

    match /therapists/{therapistId} {
      allow get: if isVerified() && isValidId(therapistId) && (isOwner(existing()) || isBootstrappedAdmin());
      allow list: if isVerified() && (resource.data.ownerId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerified()
        && isValidId(therapistId)
        && isValidTherapist(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(therapistId)
        && (isOwner(existing()) || isBootstrappedAdmin())
        && isValidTherapist(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'specialty', 'roleTitle', 'monthlyTargetHours', 'active', 'updatedAt']);
      allow delete: if isVerified() && isValidId(therapistId) && (isOwner(existing()) || isBootstrappedAdmin());
    }

    match /clients/{clientId} {
      allow get: if isVerified() && isValidId(clientId) && (isOwner(existing()) || isBootstrappedAdmin());
      allow list: if isVerified() && (resource.data.ownerId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerified()
        && isValidId(clientId)
        && isValidClient(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/therapists/$(incoming().primaryTherapistId));
      allow update: if isVerified()
        && isValidId(clientId)
        && (isOwner(existing()) || isBootstrappedAdmin())
        && isValidClient(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'program', 'defaultSppSessions', 'primaryTherapistId', 'active', 'updatedAt']);
      allow delete: if isVerified() && isValidId(clientId) && (isOwner(existing()) || isBootstrappedAdmin());
    }

    match /sppPackages/{packageId} {
      allow get: if isVerified() && isValidId(packageId) && (isOwner(existing()) || isBootstrappedAdmin());
      allow list: if isVerified() && (resource.data.ownerId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerified()
        && isValidId(packageId)
        && isValidSppPackage(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/clients/$(incoming().clientId));
      allow update: if isVerified()
        && isValidId(packageId)
        && (isOwner(existing()) || isBootstrappedAdmin())
        && isValidSppPackage(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().clientId == existing().clientId
        && incoming().monthKey == existing().monthKey
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['paidSessions', 'packageName', 'sppFee', 'paymentStatus', 'updatedAt']);
      allow delete: if isVerified() && isValidId(packageId) && (isOwner(existing()) || isBootstrappedAdmin());
    }

    match /attendanceEntries/{entryId} {
      allow get: if isVerified() && isValidId(entryId) && (isOwner(existing()) || isBootstrappedAdmin());
      allow list: if isVerified() && (resource.data.ownerId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerified()
        && isValidId(entryId)
        && isValidAttendanceEntry(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/clients/$(incoming().clientId))
        && existsAfter(/databases/$(database)/documents/therapists/$(incoming().therapistId));
      allow update: if isVerified()
        && isValidId(entryId)
        && (isOwner(existing()) || isBootstrappedAdmin())
        && isValidAttendanceEntry(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['therapistId', 'code', 'hours', 'notes', 'updatedAt']);
      allow delete: if isVerified() && isValidId(entryId) && (isOwner(existing()) || isBootstrappedAdmin());
    }

    match /therapistClaims/{claimId} {
      allow get: if isVerified() && isValidId(claimId) && (isOwner(existing()) || isBootstrappedAdmin());
      allow list: if isVerified() && (resource.data.ownerId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerified()
        && isValidId(claimId)
        && isValidTherapistClaim(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/clients/$(incoming().clientId))
        && existsAfter(/databases/$(database)/documents/therapists/$(incoming().therapistId));
      allow update: if isVerified()
        && isValidId(claimId)
        && (isOwner(existing()) || isBootstrappedAdmin())
        && isValidTherapistClaim(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isBootstrappedAdmin() ||
          (existing().reconcileStatus != 'resolved' && incoming().diff(existing()).affectedKeys().hasOnly(['code', 'claimedHours', 'reconcileStatus', 'claimNote', 'updatedAt']))
        );
      allow delete: if isVerified() && isValidId(claimId) && (isOwner(existing()) || isBootstrappedAdmin());
    }
  }
}
